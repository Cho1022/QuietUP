<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="32dp"
    android:background="@color/qup_bg">

    <!-- 위에 약간 여유 -->
    <Space
        android:layout_width="match_parent"
        android:layout_height="32dp" />

    <!-- QuietUp 로고 (네가 넣어둔 mipmap 아이콘) -->
    <ImageView
        android:id="@+id/imageLoginLogo"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_gravity="center_horizontal"
        android:src="@mipmap/ic_quietup"
        android:contentDescription="@string/app_name" />

    <!-- 로고와 입력창 사이 공간 -->
    <Space
        android:layout_width="match_parent"
        android:layout_height="24dp" />

    <!-- 이메일 -->
    <EditText
        android:id="@+id/inputLoginUserId"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="이메일"
        android:inputType="textEmailAddress"
        android:background="@android:color/transparent"
        android:padding="0dp"
        android:textSize="14sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginBottom="16dp"
        android:background="#FFBDBDBD" />

    <!-- 비밀번호 -->
    <EditText
        android:id="@+id/inputLoginUserPw"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="비밀번호"
        android:inputType="textPassword"
        android:background="@android:color/transparent"
        android:padding="0dp"
        android:textSize="14sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginBottom="16dp"
        android:background="#FFBDBDBD" />

    <!-- 위·아래 여백 조절용 : 이 Space가 버튼들을 아래로 밀어줌 -->
    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- 로그인 버튼 (초기에는 비활성 + 회색) -->
    <Button
        android:id="@+id/buttonLogin"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="로그인"
        android:textColor="@android:color/white"
        android:enabled="false"
        android:backgroundTint="@color/login_button_disabled"
        android:layout_marginBottom="12dp" />

    <!-- 회원가입 버튼 (항상 활성) -->
    <Button
        android:id="@+id/buttonLoginJoin"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="회원가입"
        android:textColor="@android:color/white"
        android:backgroundTint="@color/login_button" />

</LinearLayout>
